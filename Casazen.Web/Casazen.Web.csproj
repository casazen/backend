<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>casazen-backend-local</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.17" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lease contract templates provided by the product owner (LT-03): shipped with the API. -->
    <None Update="LeaseTemplates\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Letters of the operations of a lease, drafts until the product owner approves them (LR-OPS-1): shipped with the API. -->
    <None Update="LeaseLetters\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Texts of the legal documents provided by the product owner (D14, PL-14): docs/runbooks/legal-documents.md. -->
    <None Update="LegalDocuments\**\*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Small model files of the identity verification (E03/F04/US01, ADR-013-R8): shipped with the API once the operator adds them, each
         used only when its SHA-256 equals the pinned one. See MlModels/README.md and docs/TECHNICAL.md. -->
    <None Update="MlModels\**\*.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="MlModels\**\*.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Casazen.Core\Casazen.Core.csproj" />
    <ProjectReference Include="..\Casazen.Infrastructure\Casazen.Infrastructure.csproj" />
  </ItemGroup>

</Project>
