<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Auth0.ManagementApi" Version="7.30.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.17" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <!-- Pin the patched transitive dependency (GHSA-x33c-w48q-qrgc) until upstream raises its minimum. -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.34" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <!-- Identity verification (E03/F04/US01, ADR-013): ONNX Runtime runs the face detector, the anti-spoofing and the face recognition models in
         process, in memory only (MIT). StbImageSharp decodes the JPEG/PNG of the guest in memory (public domain, fully managed, no native code):
         ImageSharp has a revenue-threshold licence and SkiaSharp brings native binaries (docs/runbooks/suppliers.md § 33b.3). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- PDF rendering (LT-09): MIT, fully managed. Licence and font notes in docs/runbooks/lease-contract-templates.md. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Official tourist-tax PDF text extraction (RS-7): Apache-2.0, same package the tests already use. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Resend" Version="0.5.1" />
    <PackageReference Include="Stripe.net" Version="50.1.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Casazen.Core\Casazen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Casazen.Tests" />
  </ItemGroup>

  <!--
    The official FatturaPA schema and the XML signature schema it imports (E06/F01/US02/T03, ADR-019-R6): the files the Agenzia delle Entrate
    publishes, committed unchanged in Fiscal\Schemas with their source and SHA-256 in docs/runbooks/fiscal-documents.md, compiled into the assembly
    (FatturaPaSchemaProvider). A build without them validates nothing and issues no electronic invoice (fatturapa_schema_unavailable).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fiscal\Schemas\*.xsd" LogicalName="Casazen.Infrastructure.Fiscal.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The official schemas of the wire files (E06/F05/US01/T01, NF-25, ADR-017): the ISO 20022 pain.001.001.03 schema of the SEPA file (EUR) in
    Payments\Schemas\Sepa and the schema of the Swiss Payment Standards of the Swiss file (CHF) in Payments\Schemas\Swiss, the files their publishers give,
    committed unchanged with their source and SHA-256 in docs/runbooks/wire-transfers.md and compiled into the assembly (Pain001SchemaProvider). The two
    schemas share one target namespace, hence two folders and two sets. A build without the schema of a currency validates nothing and produces no wire
    file of that currency (wire_batch_schema_unavailable).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Payments\Schemas\Sepa\*.xsd" LogicalName="Casazen.Infrastructure.Payments.Schemas.Sepa.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Payments\Schemas\Swiss\*.xsd" LogicalName="Casazen.Infrastructure.Payments.Schemas.Swiss.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Fonts of the generated PDFs (LT-09): compiled into the assembly, never read from the host. -->
  <ItemGroup>
    <EmbeddedResource Include="Documents\Fonts\DejaVuSans.ttf" LogicalName="Casazen.Infrastructure.Documents.Fonts.DejaVuSans.ttf" />
    <EmbeddedResource Include="Documents\Fonts\DejaVuSans-Bold.ttf" LogicalName="Casazen.Infrastructure.Documents.Fonts.DejaVuSans-Bold.ttf" />
  </ItemGroup>

  <!--
    Official ISTAT comuni list (SU-04): the file the product owner supplied and its source and date, compiled into the assembly and loaded at
    startup when the database has no list or an older one (ComuneImportService.ImportSeedIfNewerAsync). A build without the file simply has
    no seed. Format, source and how to update it: Data/Seeds/README.md and docs/runbooks/comuni-istat.md.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Seeds\comuni-istat.csv" LogicalName="Casazen.Infrastructure.Data.Seeds.comuni-istat.csv" Condition="Exists('Data\Seeds\comuni-istat.csv')" />
    <EmbeddedResource Include="Data\Seeds\comuni-istat.source.json" LogicalName="Casazen.Infrastructure.Data.Seeds.comuni-istat.source.json" Condition="Exists('Data\Seeds\comuni-istat.source.json')" />
    <EmbeddedResource Include="Data\Seeds\alloggiati\comuni.csv" LogicalName="Casazen.Infrastructure.Data.Seeds.alloggiati.comuni.csv" Condition="Exists('Data\Seeds\alloggiati\comuni.csv')" />
    <EmbeddedResource Include="Data\Seeds\alloggiati\stati.csv" LogicalName="Casazen.Infrastructure.Data.Seeds.alloggiati.stati.csv" Condition="Exists('Data\Seeds\alloggiati\stati.csv')" />
    <EmbeddedResource Include="Data\Seeds\alloggiati\documenti.csv" LogicalName="Casazen.Infrastructure.Data.Seeds.alloggiati.documenti.csv" Condition="Exists('Data\Seeds\alloggiati\documenti.csv')" />
    <EmbeddedResource Include="Data\Seeds\alloggiati\tipo_alloggiato.csv" LogicalName="Casazen.Infrastructure.Data.Seeds.alloggiati.tipo_alloggiato.csv" Condition="Exists('Data\Seeds\alloggiati\tipo_alloggiato.csv')" />
  </ItemGroup>

  <!--
    Centres of the comuni, by ISTAT code: where a map puts a property whose host gave no position (ComuneCentroids). Built from Wikidata (CC0) by
    scripts/build-comuni-centroidi.mjs and compiled into the assembly, read once, never fetched at run time. Source, query and how to build it
    again: Data/Seeds/README.md and docs/runbooks/comuni-istat.md.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Seeds\comuni-centroidi.csv" LogicalName="Casazen.Infrastructure.Data.Seeds.comuni-centroidi.csv" />
    <EmbeddedResource Include="Data\Seeds\comuni-centroidi.source.json" LogicalName="Casazen.Infrastructure.Data.Seeds.comuni-centroidi.source.json" />
  </ItemGroup>

</Project>
