{
  "_comment": "Same variable name, different values per Vercel environment. Import via dashboard or set each row manually. Preview and Production use two different Auth0 tenants (docs/runbooks/auth0.md section 1): never the same domain or client id in both columns.",
  "variables": [
    {
      "key": "VITE_AUTH0_DOMAIN",
      "preview": "YOUR_TEST_TENANT_DOMAIN",
      "production": "YOUR_PRODUCTION_TENANT_DOMAIN"
    },
    {
      "key": "VITE_AUTH0_CLIENT_ID",
      "preview": "YOUR_TEST_TENANT_SPA_CLIENT_ID",
      "production": "YOUR_PRODUCTION_TENANT_SPA_CLIENT_ID"
    },
    {
      "key": "VITE_AUTH0_AUDIENCE",
      "preview": "https://casazen-api",
      "production": "https://casazen-api"
    },
    {
      "key": "VITE_API_BASE_URL",
      "preview": "https://your-backend-test.up.railway.app/api",
      "production": "https://your-backend-prod.up.railway.app/api"
    },
    {
      "key": "VITE_PUBLIC_SITE_URL",
      "preview": "",
      "production": "https://your-public-domain"
    },
    {
      "key": "VITE_DEMO_MODE",
      "preview": "false",
      "production": "false"
    }
  ]
}
