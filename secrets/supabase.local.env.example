# Copy to supabase.local.env and fill in (file is gitignored).
# Supabase → Project Settings → Database → Host + password

# Option A — Supavisor session pooler (IPv4, recommended on Windows)
# Dashboard → Connect → Session mode
SUPABASE_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_USERNAME=postgres.your-project-ref
SUPABASE_PASSWORD=your-database-password

# Option B — Direct (IPv6 only on many networks)
# SUPABASE_HOST=db.xxxxxxxxx.supabase.co
# SUPABASE_USERNAME=postgres
# SUPABASE_PASSWORD=your-database-password

# Optional overrides
# SUPABASE_PORT=5432
# SUPABASE_DATABASE=postgres
